{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "runtime": "python3.12",
      "entrypoint": "app:app",
      "installCommand": "uv sync --frozen --no-dev --no-editable --extra api --extra presentation",
      "functions": {
        "app.py": {
          "maxDuration": "max",
          "includeFiles": "{config,data/examples}/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
